# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Owner & Demo Admin Configuration (Optional for Portfolio Showcasing)
# UUID akun pemilik (owner). Akun dengan ID ini memiliki akses tulis penuh di panel admin.
NEXT_PUBLIC_OWNER_ID=your-owner-user-uuid

# Kredensial akun demo admin yang ditampilkan di halaman login (opsional)
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin.demo@reimarket.com
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=AdminDemo123!
